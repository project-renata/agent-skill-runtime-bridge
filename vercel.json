{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/run.py": {
      "maxDuration": 300
    },
    "api/mcp.py": {
      "maxDuration": 300
    },
    "api/repository.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/run",
      "destination": "/api/run"
    },
    {
      "source": "/api/repository",
      "destination": "/api/repository"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/mcp"
    }
  ],
  "buildCommand": "python3 maintenance/check_deployment.py && mkdir -p .vercel/static && printf 'validated\\n' > .vercel/static/policy.txt",
  "outputDirectory": ".vercel/static"
}
